# Copy this file to .env and change the passwords. .env is git-ignored — never commit it.

# --- MySQL container (docker-compose.yml) ---
MYSQL_DATABASE=bankpro
MYSQL_USER=bankpro
MYSQL_PASSWORD=change-me-dev-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_PORT=3306

# --- Backend (Spring Boot) ---
DB_URL=jdbc:mysql://localhost:3306/bankpro?serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=bankpro
DB_PASSWORD=change-me-dev-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Backend HTTP port (default 8080). If you change it, set VITE_DEV_PROXY_TARGET in frontend/.env.local too.
PORT=8080
# Phase 3: a random secret of at least 32 bytes, e.g. PowerShell:
#   openssl rand -base64 48      (run in Git Bash)
JWT_SECRET=
