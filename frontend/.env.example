# Copy to .env.local for local overrides (git-ignored).
# Leave empty in development: requests go to /api and Vite proxies them to http://localhost:8080.
# In production (Vercel) set it to the deployed backend, e.g. https://bankpro-api.example.com/api
VITE_API_BASE_URL=

# Development only: where Vite forwards /api requests. Change if the backend runs on another port.
VITE_DEV_PROXY_TARGET=http://localhost:8080
